---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	main(main)
	planner(planner)
	executor(executor)
	summarizer(summarizer)
	feedback(feedback)
	__end__([<p>__end__</p>]):::last
	__start__ --> main;
	executor --> summarizer;
	feedback -.-> __end__;
	feedback -.-> main;
	main -.-> __end__;
	main -.-> feedback;
	main -.-> planner;
	planner -.-> __end__;
	planner -.-> executor;
	summarizer --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
